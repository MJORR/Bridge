{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bridge/feature-blocks",
	"version": "2.0.0",
	"title": "Feature Blocks",
	"category": "design",
	"icon": "grid-view",
	"description": "A grid of feature panels, each with a graphic, a title and a line of copy — or a numbered run of steps.",
	"textdomain": "bridge",
	"keywords": ["features", "services", "grid", "panels", "steps", "blocks"],
	"supports": {
		"anchor": true,
		"html": false,
		"layout": false
	},
	"attributes": {
		"width": {
			"type": "string",
			"default": "wide"
		},
		"layout": {
			"type": "string",
			"enum": ["grid", "numbered"],
			"default": "grid"
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"gutters": {
			"type": "boolean",
			"default": true
		},
		"overflowStyle": {
			"type": "string",
			"enum": ["wrap", "carousel"],
			"default": "wrap"
		},
		"panelStyle": {
			"type": "string",
			"enum": ["card", "plain", "outline"],
			"default": "card"
		},
		"textAlignment": {
			"type": "string",
			"default": "left"
		},
		"mask": {
			"type": "boolean",
			"default": false
		},
		"maskShade": {
			"type": "number",
			"default": -20
		},
		"maskSize": {
			"type": "number",
			"default": 60
		},
		"maskInset": {
			"type": "number",
			"default": 0
		}
	},
	"example": {
		"attributes": {
			"columns": 3,
			"width": "wide"
		},
		"innerBlocks": [
			{
				"name": "core/heading",
				"attributes": {
					"level": 2,
					"content": "What we do"
				}
			},
			{
				"name": "bridge/feature-block",
				"attributes": {
					"title": "Strategy",
					"text": "A line about it."
				}
			},
			{
				"name": "bridge/feature-block",
				"attributes": {
					"title": "Design",
					"text": "A line about it."
				}
			},
			{
				"name": "bridge/feature-block",
				"attributes": {
					"title": "Build",
					"text": "A line about it."
				}
			}
		]
	},
	"editorScript": "bridge-feature-blocks-editor",
	"style": "bridge-feature-blocks-style",
	"viewScript": "bridge-carousel",
	"render": "file:./render.php"
}
