{
	"$comment": "Per-client design token seed. This is where a Figma export lands. Values here become the defaults the options page opens with; anything an operator saves in the admin overrides them. Slugs are fixed by the theme and must not be renamed — they are written into post content as class names (has-primary-color, has-large-font-size).",
	"version": 1,
	"brand": {
		"palette": {
			"primary": {
				"color": "#0F172A",
				"name": "Primary"
			},
			"secondary": {
				"color": "#2563EB",
				"name": "Secondary"
			},
			"accent": {
				"color": "#F59E0B",
				"name": "Accent"
			},
			"background": {
				"color": "#FFFFFF",
				"name": "Background"
			},
			"surface": {
				"color": "#F5F5F4",
				"name": "Surface"
			},
			"text": {
				"color": "#1F2937",
				"name": "Text"
			}
		}
	},
	"typography": {
		"fontSet": "system",
		"baseSize": 1,
		"scaleRatio": 1.5,
		"headingWeight": "600",
		"headingCase": "none",
		"bodyLineHeight": 1.6,
		"headingLineHeight": 1.2
	},
	"layout": {
		"contentSize": 720,
		"wideSize": 1200,
		"spacingBase": 1.5,
		"spacingIncrement": 1.5,
		"blockGap": "40",
		"rootPadding": "40",
		"sectionPadding": "70"
	},
	"icons": {
		"weight": "regular"
	},
	"buttons": {
		"skin": "solid",
		"colors": {
			"default": "primary",
			"surface": "primary",
			"accent": "primary",
			"inverted": "background"
		}
	},
	"cards": {
		"padding": "40",
		"radius": 6,
		"shadow": "soft",
		"colors": {
			"light": "#f5f5f4",
			"surface": "#ffffff",
			"primary": "#1e293b",
			"accent": "#ffffff"
		}
	},
	"header": {
		"layout": "left",
		"topBar": false,
		"search": false,
		"menus": {
			"primary": 0,
			"utility": 0
		},
		"background": "solid",
		"backgroundColor": "background",
		"contrast": "auto",
		"sticky": false,
		"border": false,
		"paddingBlock": 12,
		"logo": {
			"id": 0,
			"lightId": 0,
			"height": 40
		},
		"cta": {
			"enabled": false,
			"label": "",
			"url": ""
		}
	},
	"footer": {
		"style": "simple"
	}
}