{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bridge/cards",
	"version": "1.0.0",
	"title": "Cards",
	"category": "widgets",
	"icon": "grid-view",
	"description": "Configurable, responsive grid of post cards.",
	"textdomain": "bridge",
	"keywords": ["posts", "grid", "cards", "loop"],
	"supports": {
		"anchor": true,
		"html": false,
		"layout": false
	},
	"attributes": {
		"source": {
			"type": "string",
			"default": "self"
		},
		"width": {
			"type": "string",
			"default": "wide"
		},
		"overflowStyle": {
			"type": "string",
			"default": "wrap"
		},
		"cardStyle": {
			"type": "string",
			"enum": ["summary", "tile", "cover", "team"],
			"default": "summary"
		},
		"isPreview": {
			"type": "boolean",
			"default": false
		},
		"postType": {
			"type": "string",
			"default": "post"
		},
		"numberOfPosts": {
			"type": "number",
			"default": 6
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"orderBy": {
			"type": "string",
			"default": "date"
		},
		"order": {
			"type": "string",
			"default": "desc"
		},
		"categories": {
			"type": "array",
			"default": [],
			"items": { "type": "number" }
		},
		"excerptLength": {
			"type": "number",
			"default": 0
		},
		"showReadMore": {
			"type": "boolean",
			"default": true
		},
		"readMoreText": {
			"type": "string",
			"default": ""
		},
		"mask": {
			"type": "boolean",
			"default": false
		},
		"maskColor": {
			"type": "string",
			"default": "accent"
		},
		"maskSize": {
			"type": "number",
			"default": 60
		},
		"maskInset": {
			"type": "number",
			"default": 0
		},
		"buttonText": {
			"type": "string",
			"default": ""
		}
	},
	"example": {
		"attributes": {
			"numberOfPosts": 3,
			"columns": 3
		},
		"innerBlocks": [
			{
				"name": "core/heading",
				"attributes": {
					"level": 2,
					"content": "Latest news"
				}
			}
		]
	},
	"editorScript": "bridge-cards-editor",
	"viewScript": "bridge-carousel",
	"render": "file:./render.php"
}
