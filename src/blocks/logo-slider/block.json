{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bridge/logo-slider",
	"version": "1.0.0",
	"title": "Logo Slider",
	"category": "media",
	"icon": "images-alt2",
	"description": "A moving row of client or partner logos, with an optional second row.",
	"textdomain": "bridge",
	"keywords": ["logos", "clients", "partners", "marquee", "slider"],
	"supports": {
		"anchor": true,
		"html": false,
		"layout": false
	},
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		},
		"labelAlign": {
			"type": "string",
			"default": "left"
		},
		"labelSize": {
			"type": "string",
			"default": "medium"
		},
		"width": {
			"type": "string",
			"default": "full"
		},
		"imageDisplay": {
			"type": "string",
			"default": "contain"
		},
		"logoSize": {
			"type": "number",
			"default": 0
		},
		"logoSpace": {
			"type": "number",
			"default": 0
		},
		"speed": {
			"type": "number",
			"default": 0
		},
		"images": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object"
			}
		},
		"secondRow": {
			"type": "boolean",
			"default": false
		},
		"imagesSecond": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object"
			}
		}
	},
	"example": {
		"attributes": {
			"label": "Clients"
		}
	},
	"editorScript": "bridge-logo-slider-editor",
	"style": "bridge-logo-slider-style",
	"viewScript": "bridge-logo-slider-view",
	"render": "file:./render.php"
}
