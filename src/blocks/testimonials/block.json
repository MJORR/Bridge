{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bridge/testimonials",
	"version": "1.1.0",
	"title": "Testimonials",
	"category": "design",
	"icon": "format-quote",
	"description": "A set of customer testimonials, in a grid or a swipeable row.",
	"textdomain": "bridge",
	"keywords": [
		"testimonials",
		"reviews",
		"quotes",
		"customers",
		"social proof"
	],
	"supports": {
		"anchor": true,
		"html": false,
		"layout": false
	},
	"attributes": {
		"width": {
			"type": "string",
			"default": "wide"
		},
		"cardStyle": {
			"type": "string",
			"default": "solid"
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"overflowStyle": {
			"type": "string",
			"default": "wrap"
		},
		"mask": {
			"type": "boolean",
			"default": false
		},
		"maskShade": {
			"type": "number",
			"default": -20
		},
		"maskSize": {
			"type": "number",
			"default": 60
		},
		"maskEdge": {
			"type": "string",
			"enum": ["left", "right"],
			"default": "right"
		},
		"maskBleed": {
			"type": "number",
			"default": 0
		}
	},
	"providesContext": {
		"bridge/cardStyle": "cardStyle"
	},
	"example": {
		"attributes": {
			"columns": 3,
			"cardStyle": "solid",
			"overflowStyle": "wrap"
		},
		"innerBlocks": [
			{
				"name": "core/heading",
				"attributes": {
					"level": 2,
					"content": "What clients say"
				}
			},
			{
				"name": "bridge/testimonial",
				"attributes": {
					"text": "They understood the brief immediately.",
					"name": "A. Client",
					"company": "Acme Ltd",
					"rating": 5
				}
			},
			{
				"name": "bridge/testimonial",
				"attributes": {
					"text": "Delivered early and answered every question.",
					"name": "B. Customer",
					"company": "Widget Co",
					"rating": 5
				}
			}
		]
	},
	"editorScript": "bridge-testimonials-editor",
	"style": "bridge-testimonials-style",
	"viewScript": "bridge-carousel",
	"render": "file:./render.php"
}
