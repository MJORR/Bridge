{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bridge/hero-slider",
	"version": "1.0.0",
	"title": "Hero Slider",
	"category": "media",
	"icon": "format-gallery",
	"description": "A full-screen hero. Choose an image and it becomes the first slide; add more images to make it step. One slide shows as a plain hero \u2014 the arrows and dots appear only when there is a second.",
	"textdomain": "bridge",
	"keywords": ["slider", "hero", "carousel"],
	"supports": {
		"align": ["full"],
		"anchor": true,
		"html": false,
		"layout": false
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		},
		"heightPreset": {
			"type": "string",
			"default": "full"
		},
		"customHeight": {
			"type": "number",
			"default": 80
		},
		"customHeightUnit": {
			"type": "string",
			"default": "vh"
		},
		"effect": {
			"type": "string",
			"default": "fade"
		},
		"autoplay": {
			"type": "boolean",
			"default": true
		},
		"autoplayDelay": {
			"type": "number",
			"default": 6
		},
		"loop": {
			"type": "boolean",
			"default": true
		},
		"showPagination": {
			"type": "boolean",
			"default": true
		},
		"showNavigation": {
			"type": "boolean",
			"default": true
		}
	},
	"example": {
		"attributes": {
			"align": "full",
			"heightPreset": "medium",
			"autoplay": false
		},
		"innerBlocks": [
			{
				"name": "core/cover",
				"attributes": {
					"dimRatio": 50,
					"minHeight": 80,
					"minHeightUnit": "vh",
					"contentPosition": "center center",
					"customOverlayColor": "#0f172a"
				},
				"innerBlocks": [
					{
						"name": "core/heading",
						"attributes": {
							"level": 1,
							"textAlign": "center",
							"content": "A headline over a photograph"
						}
					}
				]
			}
		]
	},
	"editorScript": "bridge-hero-slider-editor",
	"style": "bridge-hero-slider-style",
	"render": "file:./render.php"
}
